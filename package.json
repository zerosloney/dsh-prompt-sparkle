{
  "name": "dsh-prompt-sparkle",
  "version": "0.1.2",
  "description": "DeepSeek Harness 插件：对话框提示词润色——在 composer 工具栏模型选择器旁挂 sparkle 图标按钮（+ Ctrl/Cmd+Shift+E），用当前会话的模型把草稿重写为更清晰的提示词，结果写回输入框（Ctrl/Cmd+Z 可撤销）。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosloney/dsh-prompt-sparkle.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:compat": "node scripts/run-compat-tests.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7 <0.2.0 || >=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.7 <0.2.0 || >=0.1.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.2.0 || >=0.1.1-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "semver": "^7.7.2",
    "typescript": "^5.8.0"
  }
}